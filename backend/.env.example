PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/lscustoms
JWT_SECRET=put-a-long-random-string-here
FRONTEND_ORIGIN=http://localhost:5173

# ---- Email (OTP codes + booking status emails) ----
# Required: without these, sending a code fails with an error.
# (Offline dev only: MAIL_CONSOLE=true prints emails in the terminal instead.)
# Gmail: turn on 2-Step Verification, then create an "App Password"
#        (Google Account > Security > App passwords). Use THAT, not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourshop@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="LS Customs" <yourshop@gmail.com>

# Optional: shown in the email footer
# SHOP_ADDRESS=123 Pickup Coffee, Pasay City, PH
# SHOP_PHONE=+63 917 676 6767
# Optional: seed.js admin
# ADMIN_EMAIL=admin@lscustoms.com
# ADMIN_PASSWORD=Admin12345
